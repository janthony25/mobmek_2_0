# Local secrets for docker compose — see .env.example for the template.
.env

# Legacy MSSQL backup for the one-time data import (real customer data — never commit).
# See docs/legacy-import-design.md §1.1.
legacy-backup/
legacy-import-report-*.md

# Local-only compose overrides (e.g. mounting ~/.aws so the api container can reach S3).
# Per-developer, never deployed — see infrastructure/docs/phase-1-plan.md.
docker-compose.override.yml

# Generated by scripts/generate-migration-script.sh — always regenerate from the current
# migrations rather than committing a copy that can go stale.
/migrate.sql
