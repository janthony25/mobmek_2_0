# Copy to .env (gitignored) and fill in real values before deploying anywhere
# beyond a throwaway local machine. docker compose reads .env automatically.

# --- Database ---
POSTGRES_PASSWORD=postgres

# --- Bootstrap admin account (see docs/auth-module-design.md) ---
# Created once on a fresh database if no Admin account exists yet.
BOOTSTRAP_ADMIN_EMAIL=justforvalo25@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=DevAdmin!2026

# --- Outbound email (see docs/email-module-design.md) ---
# From resend.com, once your sending domain is verified there. Leave blank to run without
# email — sends will show a "not configured" setup hint instead of erroring.
RESEND_API_KEY=

# --- Google Calendar sync (see docs/google-calendar-sync-design.md) ---
# Service-account JSON key content (not a file path) for the calendar sync's own Google Cloud
# project — paste the whole downloaded key file's contents on one line. Leave blank to run
# without calendar sync — appointments still book normally, just don't push to Google.
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# The "Mobmek Workshop" calendar's id (Calendar settings → Integrate calendar), e.g.
# xxxxxxxx@group.calendar.google.com.
GOOGLE_CALENDAR_ID=

# --- Uploaded file storage (job photos, transaction receipts, business logo) ---
# "Local" stores files in a directory inside the api container; "S3" stores them in an S3
# bucket. Local is fine for development, but a real deployment must use S3 — the container's
# filesystem is discarded on every `docker compose up --build`, which would destroy every
# photo, receipt and the logo while their database rows survive (leaving broken images).
FILE_STORAGE_PROVIDER=Local
# Required when FILE_STORAGE_PROVIDER=S3 — the api refuses to start without it. The
# provisioned production bucket is mobmek-uploads-649058763120.
FILE_STORAGE_S3_BUCKET=
# Leave blank on EC2 — the instance's own region is used. The EC2 instance role supplies
# credentials automatically, so no access keys belong in this file.
FILE_STORAGE_S3_REGION=

# --- Frontend base URL ---
# Used to build absolute links in emails (e.g. the new-account activation link). Set to the
# real deployed frontend origin in production.
FRONTEND_BASE_URL=http://localhost:3000

# --- Runtime environment ---
# Development auto-applies EF migrations on startup and exposes Swagger — do NOT
# use it in production. Set this to "Production" for a real deployment and run
# migrations as a deliberate separate step (see mobmek_api/CLAUDE.md).
ASPNETCORE_ENVIRONMENT=Development
